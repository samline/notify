---
import { diagrams, type DemoPreset } from '../i18n/translations/en/demo'
interface Props {
  preset: DemoPreset
}
const { preset } = Astro.props
const diagram = diagrams[preset]
const [y, x] = diagram.position.split('-')
const behind = Math.max(0, diagram.stack - 1)
---

<div
  class:list={['toast-diagram']}
  data-y={y}
  data-x={x}
  data-ghost={diagram.ghost ? '' : undefined}
  aria-hidden="true"
>
  <span class:list={['diagram-line']}></span>
  <span class:list={['diagram-line']}></span>
  <span class:list={['diagram-line']}></span>
  <div class:list={['diagram-stack']}>
    {Array.from({ length: behind }, (_, index) => (
      <span class:list={['diagram-behind']} style={`--depth:${behind - index}`} />
    ))}
    <div class:list={['diagram-toast']} data-type={diagram.type}>
      {diagram.close && <span class:list={['diagram-close']} />}
      {diagram.type === 'custom' ? (
        <span class:list={['diagram-custom']}>
          <span />
          <span />
          <span class:list={['diagram-field']} />
        </span>
      ) : (
        <>
          <span class:list={['diagram-icon']} />
          <span class:list={['diagram-text']}>
            <span />
            {diagram.description && <span />}
            {diagram.progress && <span class:list={['diagram-progress']} />}
          </span>
        </>
      )}
      {diagram.actions > 0 && (
        <span class:list={['diagram-actions']}>
          {Array.from({ length: diagram.actions }, (_, index) => (
            <span data-primary={index === diagram.actions - 1 ? '' : undefined} />
          ))}
        </span>
      )}
    </div>
  </div>
</div>

<style>
  .toast-diagram {
    --diagram-success: oklch(0.72 0.17 150);
    --diagram-error: oklch(0.66 0.2 25);
    --diagram-info: oklch(0.68 0.15 245);
    --diagram-warning: oklch(0.8 0.15 80);
    position: relative;
    min-height: 11rem;
    border: 0.0625rem solid var(--palette-studio-border);
    border-radius: var(--radius-control);
    background: var(--palette-studio-surface);
    padding: var(--space-lg);
    overflow: hidden;
  }
  .diagram-line {
    display: block;
    width: 45%;
    height: 0.375rem;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
  }
  .diagram-line:nth-child(2) {
    width: 65%;
  }
  .diagram-line:nth-child(3) {
    width: 30%;
  }
  .toast-diagram[data-y='top'] .diagram-line {
    margin-top: 4.25rem;
  }
  .toast-diagram[data-y='top'] .diagram-line ~ .diagram-line {
    margin-top: 0;
  }
  .diagram-stack {
    position: absolute;
    inset-inline: var(--space-sm);
    bottom: var(--space-sm);
    display: grid;
    justify-items: end;
  }
  [data-x='left'] .diagram-stack {
    justify-items: start;
  }
  [data-x='center'] .diagram-stack {
    justify-items: center;
  }
  [data-y='top'] .diagram-stack {
    top: var(--space-sm);
    bottom: auto;
  }
  .diagram-toast,
  .diagram-behind {
    grid-area: 1 / 1;
    box-sizing: border-box;
    width: min(100%, 13.5rem);
    border: 0.0625rem solid var(--palette-studio-border);
    border-radius: 0.5rem;
    background: var(--palette-specimen-surface);
    box-shadow: 0 0.5rem 1.25rem -0.75rem #0007;
  }
  .diagram-behind {
    align-self: end;
    height: 2.75rem;
    transform: translateY(calc(var(--depth) * -0.45rem)) scale(calc(1 - var(--depth) * 0.06));
    opacity: calc(1 - var(--depth) * 0.3);
  }
  [data-y='top'] .diagram-behind {
    align-self: start;
    transform: translateY(calc(var(--depth) * 0.45rem)) scale(calc(1 - var(--depth) * 0.06));
  }
  [data-ghost] .diagram-behind {
    opacity: 0.35;
    border-style: dashed;
  }
  .diagram-toast {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
  }
  .diagram-icon {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-text-subtle);
  }
  [data-type='success'] .diagram-icon {
    background: var(--diagram-success);
  }
  [data-type='error'] .diagram-icon {
    background: var(--diagram-error);
  }
  [data-type='info'] .diagram-icon {
    background: var(--diagram-info);
  }
  [data-type='warning'] .diagram-icon {
    background: var(--diagram-warning);
  }
  [data-type='loading'] .diagram-icon {
    background: none;
    border: 0.125rem solid var(--color-accent-soft);
    border-top-color: var(--color-accent);
    box-sizing: border-box;
  }
  .diagram-text,
  .diagram-custom {
    display: grid;
    flex: 1 1 6rem;
    gap: 0.35rem;
    min-width: 0;
  }
  .diagram-text span,
  .diagram-custom span {
    height: 0.3rem;
    width: 80%;
    border-radius: var(--radius-pill);
    background: var(--palette-specimen-text);
    opacity: 0.55;
  }
  .diagram-text span + span,
  .diagram-custom span + span {
    width: 55%;
    opacity: 0.3;
  }
  .diagram-text .diagram-progress {
    width: 100%;
    opacity: 1;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0 60%,
      var(--color-accent-soft) 60% 100%
    );
  }
  .diagram-custom .diagram-field {
    width: 100%;
    height: 1.25rem;
    opacity: 1;
    background: none;
    border: 0.0625rem solid var(--palette-studio-border);
    border-radius: 0.3rem;
  }
  .diagram-actions {
    display: flex;
    gap: 0.35rem;
    margin-inline-start: auto;
  }
  [data-type='custom'] .diagram-actions {
    flex-basis: 100%;
    justify-content: flex-end;
  }
  .diagram-actions span {
    width: 2.25rem;
    height: 1rem;
    border-radius: 0.25rem;
    background: var(--color-accent-soft);
  }
  .diagram-actions [data-primary] {
    background: var(--color-accent);
  }
  .diagram-close {
    position: absolute;
    top: -0.3rem;
    inset-inline-start: -0.3rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 0.0625rem solid var(--palette-studio-border);
    border-radius: 50%;
    background: var(--palette-specimen-surface);
  }
  @media (width < 48rem) {
    .toast-diagram {
      min-height: 9rem;
    }
  }
</style>
