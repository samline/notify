{
  "name": "notify-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/assets.mjs && node scripts/dev.mjs",
    "build": "node scripts/assets.mjs && bun run --cwd docs build && bun run --cwd landing build && node scripts/assemble.mjs && node scripts/check-site.mjs && bun run check:migration",
    "preview": "bun run --cwd landing preview --host 127.0.0.1 --port 4390",
    "check": "bun run check:docs && bun run check:integrations && node scripts/check-config.mjs && bun run check:design && bun run --cwd landing check && bun run --cwd docs check",
    "format": "prettier --plugin prettier-plugin-astro --write .",
    "format:check": "prettier --plugin prettier-plugin-astro --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "bun run check && bun run format:check && bun run test && bun run test:adaptation && bun run build && bun run check:identity && bun run test:browser",
    "configure": "node scripts/configure.mjs",
    "postinstall": "node scripts/assets.mjs",
    "check:release": "bun run check:identity && node scripts/check-release.mjs",
    "test:adaptation": "node scripts/test-adaptation.mjs",
    "check:design": "node scripts/check-design.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "check:docs": "node scripts/sync-docs.mjs --check",
    "check:integrations": "node scripts/check-integrations.mjs && node scripts/check-recipe-types.mjs",
    "check:migration": "node scripts/check-migration.mjs",
    "check:identity": "node scripts/check-identity.mjs --package-root .."
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.1",
    "@playwright/test": "1.62.1",
    "@samline/notify": "^5.0.0",
    "@types/react": "^19.3.0",
    "@vue/compiler-sfc": "^3.5.44",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "postcss": "8.5.28",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "react": "^19.3.1",
    "svelte": "^5.57.3",
    "typescript": "^5.9.3"
  }
}
