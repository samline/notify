---
import CodeFiles from './CodeFiles.astro'
import Tabs from './Tabs.astro'
import TabPanel from './TabPanel.astro'
import { createDemoFiles } from '../lib/demo-files'
import t, { type DemoPreset } from '../i18n/translations/en/demo'
interface Props {
  preset?: DemoPreset
}
const { preset = 'save' } = Astro.props
const modes = await Promise.all(
  t.modes.map(async mode => ({ ...mode, ...(await createDemoFiles(preset, mode.id)) }))
)
---

<Tabs
  data-demo-modes
  id={`source-${preset}-${crypto.randomUUID()}`}
  label="Example loading mode"
  items={t.modes}
>
  {modes.map(mode => (
    <TabPanel id={mode.id} label={mode.label}>
      <CodeFiles
        files={mode.files}
        complete={{ code: mode.complete.code, copyLabel: t.copyComplete }}
      />
    </TabPanel>
  ))}
</Tabs>
