{
  "name": "@samline/notify",
  "version": "4.0.0",
  "description": "Accessible, dependency-free toast notifications for JavaScript and TypeScript, with ESM, CommonJS, and browser builds.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://samline.github.io/notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/notify.git"
  },
  "bugs": {
    "url": "https://github.com/samline/notify/issues"
  },
  "keywords": [
    "toast",
    "notification",
    "notifications",
    "vanilla",
    "typescript",
    "javascript",
    "browser",
    "accessible",
    "framework-agnostic"
  ],
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/browser/global.global.js",
    "./dist/styles.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/package-smoke.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:check": "npm --prefix site run check",
    "site:format": "npm --prefix site run format",
    "site:format:check": "npm --prefix site run format:check",
    "site:test": "npm --prefix site run test",
    "site:test:browser": "npm --prefix site run test:browser",
    "site:verify": "npm --prefix site run verify",
    "site:configure": "npm --prefix site run configure",
    "site:check:design": "npm --prefix site run check:design",
    "site:check:release": "npm --prefix site run check:release",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test && npm run test:package",
    "test:package:browser": "node test/package-browser.mjs"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "vite": "7.3.7",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^5.0.5"
  }
}
