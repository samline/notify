---
import CardGrid from '../../../shared/components/CardGrid.astro'
import { getI18n } from '../i18n/utils'
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RichText from '../components/RichText.astro'
import FeatureCard from '../components/FeatureCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.features
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  id="features"
  class:list={['content-section features-section']}
>
  <Box>
    <SectionHeading
      headingId={headingId}
      context="features"
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      {t.title}
      <br />
      <span class:list={['serif italic']}>{t.titleAccent}</span>
    </SectionHeading>

    <CardGrid columns={3} class:list={['feature-grid']}>
      <FeatureCard title={t.items.dependencies.title} number="01">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.dependencies.description} />
      </FeatureCard>
      <FeatureCard title={t.items.accessibility.title} number="02">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-9l-5 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
            <path d="M8 9h8M8 12.5h5"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.accessibility.description} />
      </FeatureCard>
      <FeatureCard title={t.items.lifecycle.title} number="03">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M3 8h18"></path>
            <rect x="11" y="13" width="7" height="4" rx="1"></rect>
          </svg>
        </Fragment>
        <RichText parts={t.items.lifecycle.description} />
      </FeatureCard>
      <FeatureCard title={t.items.entrypoints.title} number="04">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.entrypoints.description} />
      </FeatureCard>
      <FeatureCard title={t.items.frameworks.title} number="05">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 2v5M15 2v5"></path>
            <path d="M6 7h12v4a6 6 0 0 1-12 0V7z"></path>
            <path d="M12 17v5"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.frameworks.description} />
      </FeatureCard>
      <FeatureCard title={t.items.markup.title} number="06">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M8 4h8M6 7h12"></path>
            <rect x="3" y="10" width="18" height="10" rx="2"></rect>
            <path d="M6.5 15h4"></path>
            <rect x="13" y="13.5" width="5" height="3" rx="1.5"></rect>
          </svg>
        </Fragment>
        <RichText parts={t.items.markup.description} />
      </FeatureCard>
    </CardGrid>
  </Box>
</Section>

<style>
  .feature-grid {
    gap: 0.75rem;
  }
  @media (width < 48rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 30rem) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
