---
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import DemoFooter from './DemoFooter.astro'
import Button from './Button.astro'
import Disclosure from './Disclosure.astro'
import DemoCode from './DemoCode.astro'
import ToastDiagram from './ToastDiagram.astro'
import t, { presets, type DemoPreset } from '../i18n/translations/en/demo'
import { bodyFor } from '../lib/demo-source'
import '../lib/demo-styles.css'
interface Props {
  preset?: DemoPreset
  showCode?: boolean
  framed?: boolean
}
const { preset = 'save', showCode = false, framed = true } = Astro.props
const copy = presets[preset]
const Frame = framed ? DemoStudio : 'div'
---

<div data-ui class:list={['playground']}>
  <Frame>
    <DemoPanel label={copy.label} tagline={t.previewTagline}>
      <div class:list={['specimen']}>
        <package-site-demo
          data-notify-demo
          data-preset={preset}
          class:list={['notify-demo']}
          role="group"
          aria-label={copy.eyebrow}
        >
          <Fragment set:html={bodyFor(preset)} />
          <div class:list={['notify-demo-actions']}>
            <Button data-demo-action disabled>
              {copy.action}
            </Button>
            {['persistent', 'history'].includes(preset) && (
              <Button data-demo-dismiss variant="secondary">
                {t.dismiss}
              </Button>
            )}
            {preset === 'task' && (
              <Button data-demo-cancel disabled variant="secondary">
                {t.cancel}
              </Button>
            )}
            <Button data-demo-reset variant="ghost">
              {t.reset}
            </Button>
          </div>
          <noscript>
            <p>{t.noscript}</p>
          </noscript>
        </package-site-demo>
        <ToastDiagram preset={preset} />
      </div>
    </DemoPanel>
    <DemoFooter note={copy.note} controls={false} />
  </Frame>
  {showCode && (
    <Disclosure class:list={['code-disclosure']}>
      <span slot="summary">{t.openCode}</span>
      <div class:list={['code-body']}>
        <p>{t.note}</p>
        <DemoCode preset={preset} />
      </div>
    </Disclosure>
  )}
</div>
<script>
  import { mountElements } from '../lib/mount-elements'
  import { browser, destroyToaster } from '@samline/notify'
  import '@samline/notify/styles.css'
  import { scenarios } from '../lib/demo-behavior.js'
  import { messages } from '../i18n/translations/en/demo'

  // All previews share the page's one toaster. Start every configuration from
  // the same baseline, so a preview's position or direction never leaks into the
  // next one, and follow the page theme unless a scenario chooses its own.
  const pageTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light')
  let followsPage = true
  const notify = {
    ...browser,
    createToaster: (options: Parameters<typeof browser.createToaster>[0] = {}) => {
      followsPage = options.theme === undefined
      return browser.createToaster({
        position: 'bottom-right',
        dir: 'ltr',
        visibleToasts: 3,
        expand: false,
        style: { '--width': '22.25rem' },
        ...options,
        theme: options.theme ?? pageTheme(),
      })
    },
  }
  // Updating only the theme leaves the remaining lifetime of open toasts alone.
  document.addEventListener('package-site:theme-change', () => {
    if (followsPage) browser.getToaster()?.update({ theme: pageTheme() })
  })

  let previews = 0
  mountElements('package-site-demo', element => {
    previews += 1
    const lifecycle = new AbortController()
    scenarios[element.dataset.preset as keyof typeof scenarios](
      element,
      notify,
      messages,
      lifecycle.signal
    )
    element.querySelector<HTMLButtonElement>('[data-demo-action]')!.disabled = false
    element.removeAttribute('inert')
    element.dataset.ready = 'true'
    return () => {
      // Reset first: it cancels pending work and dismisses the preview's toasts.
      element.querySelector<HTMLButtonElement>('[data-demo-reset]')!.click()
      lifecycle.abort()
      element.dataset.ready = 'false'
      previews -= 1
      if (previews === 0) destroyToaster()
    }
  })
</script>
<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    min-width: 0;
  }
  package-site-demo {
    display: grid;
    min-width: 0;
  }
  .specimen {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
    align-items: start;
    gap: var(--space-xl);
  }
  @media (width < 56rem) {
    .specimen {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
  .code-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-sm);
  }
  .code-body > p {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
  .code-disclosure {
    margin-top: var(--space-lg);
    padding-block: var(--space-xs);
  }
</style>
